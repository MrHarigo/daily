{
  "name": "daily",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-test-user": "tsx scripts/seed-test-user.ts",
    "prepare": "test -d .git && ln -sf ../../.github/hooks/pre-commit .git/hooks/pre-commit || true",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:auth": "E2E_AUTHENTICATED=1 playwright test",
    "test:e2e:auth:ui": "E2E_AUTHENTICATED=1 playwright test --ui",
    "test:e2e:auto": "E2E_AUTHENTICATED=1 E2E_AUTOMATED=1 playwright test",
    "test:e2e:auto:ui": "E2E_AUTHENTICATED=1 E2E_AUTOMATED=1 playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@neondatabase/serverless": "^1.0.2",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "@types/ws": "^8.18.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.18.0",
    "next": "16.0.7",
    "react": "19.2.0",
    "react-colorful": "^5.7.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.0",
    "resend": "^6.5.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.18.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "lint-staged": "^16.2.7",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "tsc-files": "^1.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "tsc-files --noEmit"
    ]
  }
}
